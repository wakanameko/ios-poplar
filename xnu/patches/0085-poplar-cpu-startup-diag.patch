diff --git a/iokit/Kernel/arm/SweetCPU.cpp b/iokit/Kernel/arm/SweetCPU.cpp
index d9248b2..d0ff7c2 100644
--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -121,6 +121,25 @@ SweetCPU::start(IOService *provider)
 	return true;
 }
 
+/*
+ * poplar bring-up diagnostic: a thread that logs every 5 s. If the ticks keep coming while
+ * startAll is stuck, timers and the scheduler work and the hang is in the CPU start path;
+ * if they stop too, the whole CPU is stuck (interrupts, a spin, or a fault with no output).
+ */
+static volatile uint32_t sweet_startall_step;
+
+static void
+sweet_heartbeat(void *arg __unused, wait_result_t result __unused)
+{
+	for (uint32_t n = 1;; n++) {
+		IOSleep(5000);
+		SweetCPU *cpu0 = __atomic_load_n(&sweet_cpus[0], __ATOMIC_ACQUIRE);
+		IOLog("SWEET TICK %u: step=%u registered=%u cpu0=%p signal=%d\n", n,
+		    sweet_startall_step, __atomic_load_n(&sweet_cpus_registered, __ATOMIC_ACQUIRE),
+		    cpu0, (int)sweet_cpu_signal_is_enabled(0));
+	}
+}
+
 /* Do not wait in a nub's start(): matching can be asynchronous or serialized. */
 void
 SweetCPU::startAll(void *arg __unused, wait_result_t result __unused)
@@ -130,6 +149,13 @@ SweetCPU::startAll(void *arg __unused, wait_result_t result __unused)
 	PE_parse_boot_argn("cpus", &requested, sizeof(requested));
 	IOLog("SWEET CPU: requested=%u selected=%u (limit=%u)\n",
 	    requested, topology->num_cpus, SWEET_SMP_MAX_CPUS);
+	{
+		thread_t hb;
+		if (kernel_thread_start(sweet_heartbeat, NULL, &hb) == KERN_SUCCESS) {
+			thread_deallocate(hb);
+		}
+	}
+	sweet_startall_step = 1;
 
 	uint64_t deadline;
 	nanoseconds_to_deadline(10 * NSEC_PER_SEC, &deadline);
@@ -149,9 +175,16 @@ SweetCPU::startAll(void *arg __unused, wait_result_t result __unused)
 	if (topology->boot_cpu->cpu_id != 0 || topology->boot_cpu->phys_id != 0x100) {
 		panic("SWEET CPU: expected boot MPIDR 0x100 and logical CPU 0");
 	}
+	sweet_startall_step = 2;
+	IOLog("SWEET CPU: registered=%u, boot cpu check OK\n",
+	    __atomic_load_n(&sweet_cpus_registered, __ATOMIC_ACQUIRE));
 	for (unsigned int i = 0; i < topology->num_cpus; i++) {
 		SweetCPU *cpu = __atomic_load_n(&sweet_cpus[i], __ATOMIC_ACQUIRE);
+		IOLog("SWEET CPU: cpu=%u calling processor_start\n", i);
+		sweet_startall_step = 10 + i * 10;
 		kern_return_t kr = processor_start(cpu->machProcessor);
+		sweet_startall_step = 11 + i * 10;
+		IOLog("SWEET CPU: cpu=%u processor_start returned %d\n", i, kr);
 		if (kr != KERN_SUCCESS) {
 			panic("SWEET CPU: cpu=%u processor_start failed: %d", i, kr);
 		}
